# Ключи из App Console: https://www.dropbox.com/developers/apps
# Секрет держим только на сервере, в браузер он не попадает.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Должен ТОЧНО совпадать с Redirect URI, прописанным в настройках приложения
DROPBOX_REDIRECT_URI=http://localhost:3000/api/dropbox/callback

# Корень Dropbox на диске
VIARDE_ROOT=D:/Viarde Studio Dropbox
